# Public build-time values only. Never put private keys in VITE_* variables.
# Public enquiry API override. The website uses this live service URL by default.
# Change only if the infrastructure team deploys the API at a different confirmed URL.
# Rebuild the frontend after changing this public value. Email secrets are Worker-only.
VITE_ENQUIRY_API_URL=https://exfedu-enquiries.exafluence.workers.dev/api/enquiries
# Required by the existing programme recommender client.
# Use the project URL and publishable key from your approved service configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Existing managed project identifier, if retaining the managed service.
VITE_SUPABASE_PROJECT_ID=